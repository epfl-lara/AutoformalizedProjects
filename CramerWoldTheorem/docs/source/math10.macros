%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Construction for making sans serif math symbols.
%% Use as \def\Prob{\mathss{Prob}}
%% This is obsolete.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%\font\ss=cmss10
%\font\eightss=cmss8
%%\font\sixss=cmss8.263   %at 8 truept
%\font\sixss=cmss8 at 6pt
%
%\def\mathss#1{{\mathchoice{{\hbox{\ss #1}}}{{\hbox{\ss
  %#1}}}{{\hbox{\eightss #1}}}{{\hbox{\sixss #1}}}}}
\def\mathss#1{{\ss #1}}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Here are some formatting macros.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\def\head#1#2{\headline{\eightpoint \ss \frenchspacing
 {\ifnum\pageno=1 \underbar{\raise2pt \line {#1 \hfill #2}}\else\hfil \fi}}}

\def\firstheader{\eightpoint\ss\underbar{\raise2pt\line 
    {\hfil Version of \versiondate}}}

\def\title#1{\centerline{\fourteenpointbold #1}}

\def\author#1{\bigskip\centerline{\sc by #1}}

\long\def\abstract#1{\vskip.6in\begingroup\ninepoint\narrower\narrower
 \noindent{\bf Abstract.} #1\bigskip\endgroup}

\def\bottomIII#1#2#3{{\eightpoint\parindent=0pt\parskip=2pt\footnote{}
 {{\it 2010 Mathematics Subject Classification.}
 #1}\footnote{}{{\it Key words and phrases.} #2}\footnote{}{#3}}}

\def\bottomII#1#2#3{{\eightpoint\parindent=0pt\parskip=2pt\footnote{}
 {{\it 2000 Mathematics Subject Classification.}
 #1}\footnote{}{{\it Key words and phrases.} #2}\footnote{}{#3}}}

\def\bottom#1#2#3{{\eightpoint\parindent=0pt\parskip=2pt\footnote{}
 {{\it 1991 Mathematics Subject Classification.}
 #1}\footnote{}{{\it Key words and phrases.} #2}\footnote{}{#3}}}

\def\proclaimfont{\sc}
\outer\def\proclaim #1. #2\par{\medbreak \noindent \begingroup
 \proclaimfont #1. \endgroup
 \begingroup\it #2\par \endgroup
 \ifdim \lastskip <\medskipamount \removelastskip \penalty
 55\medskip \fi}  
 % The \par must go inside the group or it will sometimes cause an extra
 % skip at the top of a page.
 % Note that \sc makes more space than \rm for the number.

\def\msnote#1{\ifproofmode {\bf[** #1 **]}\else\relax\fi}
\long\def\comment#1{\relax}

\def\itemrm#1{\item{{\rm #1}}}
\def\itemitemrm#1{\itemitem{{\rm #1}}}
\def\beginitems{\begingroup\parindent=25pt}
\def\enditems{\vskip0pt\endgroup\noindent}

\def\beginbulletitems{\begingroup\parindent=25pt}
\def\bullitem{\item{$\bullet$}}
\def\endbulletitems{\smallbreak\endgroup}

\def\beginbullets{\begingroup\everypar={$\bullet$\enspace}}
\def\endbullets{\smallbreak\endgroup}

\def\technical{\medbreak\begingroup\eightpoint\narrower\noindent}
\def\endtechnical{\smallbreak\endgroup\noindent}

\def\beginreferences{\vskip0pt plus.3\vsize \penalty -150 \vskip0pt
 plus-.3\vsize \bigskip\bigskip \vskip \parskip
 \begingroup\baselineskip=12pt\frenchspacing
   \multiply\baselineskip by \baselineskipmultiplier
   \centerline{\bf REFERENCES}
   \vskip12pt\parindent=0pt
   \def\and{{\rm and }}
   \def\rrf##1 (##2){{\sc ##1}\ (##2).}
   \everypar={\hangindent=.8cm\hangafter=1\rrf }}
\def\endreferences{\bigskip\bigskip\endgroup}

\def\ibid{{\vrule width 1.25cm height 0.33pt depth 0.33pt}} %Unused.
\def\bib#1{[{\bf #1}]}  %%Unused.

\def\myaddress{\hfill\hbox{\vbox{\hsize2.31in  %\eightpoint
 \sc \parskip=0pt \baselineskip=12pt
 \multiply\baselineskip by \baselineskipmultiplier
Department of Mathematics\par
831 E. 3rd St.\par
Indiana University\par
Bloomington, IN 47405-7106}}}

\def\dfn#1{{\bfi #1\/}}   % font to use for defined terms

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Here are some abbreviations for common math items.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\def\proof{\medbreak\noindent{\it Proof.\enspace}}
\def\qed{\hfill \vrule height7.5pt width4.17pt depth0pt}
\def\Qed{\relax \ifmmode  \eqno \qed
          \else \hglue3pt \qed \medbreak \fi} 
     %% See p. 240 of the TeXBook for this use of \relax.
\def\AQed{& \qed}  %% Aligned \qed for use in \eqalignno.
%\def\Qed\relax\ifmmode \qquad \qed \else \hglue3pt \qed \medbreak \fi}
           %% It is best not to use \Qed in mathmode so that it is right
           %% justified.
\long\def\remark{\noindent{\sc Remark.\enspace}}
\long\def\Remark#1\par{\medbreak\remark #1 \medbreak}
   %% To have more than one paragraph in a single remark, separate them
   %% by \vskip\parskip instead of by blank lines.
\def\example{\noindent{\sc Example:\enspace}}
\outer\def\Example#1{\medbreak\example #1 \medbreak}
\def\Question#1\par{\medbreak \noindent {\bf Question.} \enspace #1 \medbreak}
\def\Conjecture#1\par{\medbreak \noindent {\bf Conjecture.} \enspace #1 \medbreak}
\def\solution{\noindent{\sc Solution:\enspace}}
\def\note{\noindent{\sc Note:\enspace}}
\def\definition{\noindent{\sc Definition.\enspace}}
\def\notation{\noindent{\sc Notation.\enspace}}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Here are some symbols used in math.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\def\esssup{\mathop{\rm ess\, sup}}
\def\essinf{\mathop{\rm ess\, inf}}
\def\implies{\quad\Longrightarrow\quad}  % meant for displays
\def\st{\, ; \;}  %% "such that" in sets
\def\buldot{{\scriptscriptstyle\bullet}}  %% Bullet dot, a medium-size dot.
\def\cbuldot{{\raise.25ex\hbox{$\scriptscriptstyle\bullet$}}}
                                        %% Centered bullet dot.
%[
\def\OC#1{(#1]}        %% These allow for half-open intervals
\def\CO#1{[#1)}        %% while not leaving unmatched parentheses.
%]
\def\all#1{\forall #1\enspace}
\def\texists#1{\exists #1\enspace}
\def\Var{{\rm Var}}
\def\xor{\mathbin{\triangle}}  

\def\I#1{{\bf 1}_{#1}}
\def\II#1{\I{\{#1\}}}
\def\III#1{\I{[#1]}}
\def\N{{\Bbb N}}
\def\Q{{\Bbb Q}}
\def\R{{\Bbb R}}
\def\C{{\Bbb C}}
\def\Z{{\Bbb Z}}

\def\CHI{\mathchoice%
{\raise2pt\hbox{$\chi$}}%
{\raise2pt\hbox{$\chi$}}%
{\raise1.3pt\hbox{$\scriptstyle\chi$}}%
{\raise0.8pt\hbox{$\scriptscriptstyle\chi$}}}   %% A raised \chi.

\def\smalloplus{\raise1pt\hbox{$\,\scriptstyle \oplus\;$}}


%%%%
% proba symbols:

\let\oldP=\P  % paragraph symbol
\def\P{\mathop{\hbox{}{\bf P}}\nolimits\mathopen{}}
\def\E{\mathop{\hbox{}{\bf E}}\nolimits\mathopen{}}
%\def\P{\mathop{\kern0pt{\bf P}}\nolimits}
%\def\E{\mathop{\kern0pt{\bf E}}\nolimits}
% The above automatically solve spacing issues that the below encounter.
% This is based on the spacing between math atoms, as explained in Chap. 18
% of the TeXbook (chart on p. 170). If a \mathop consists of only one
% character, then it gets lowered (Rule 13 of App. G; see
% http://tex.stackexchange.com/questions/41261/mathop-shifts-the-baseline-declaremathoperator-doesnt/41267#41267
% ), so we add a \kern0pt to prevent that. In fact, \hbox{} is better in
% that it does not change the location of the superscript. I think this is
% because of Rule 18a of App. G. If we used \smash, then an accent on top
% (such as \tilde) would not be placed properly.
%\def\P{{\bf P}}
%\def\E{{\bf E}}

\def\Psub_#1{\P_{\! #1}}
\def\Pleft#1{\P\mkern-1mu\left[#1\right]}
\def\Psubleft#1#2{\Psub_{#1}\mkern-1mu\left[#2\right]}
\def\Pmedbig#1{\P\medbigl[#1\medbigr]}
\def\Psubmedbig_#1#2{\Psub_{#1}\mkern-1mu\medbigl[#2\medbigr]}
\def\Pmeddbig#1{\P\meddbigl[#1\meddbigr]}
\def\Psubmeddbig_#1#2{\Psub_{#1}\mkern-1mu\meddbigl[#2\meddbigr]}
\def\Pbig#1{\P\mkern-1.5mu\bigl[#1\bigr]}
\def\Psubbig_#1#2{\Psub_{#1}\mkern-1.5mu\bigl[#2\bigr]}
\def\Pbigg#1{\P\mkern-1.5mu\biggl[#1\biggr]}
\def\Psubbigg_#1#2{\Psub_{#1}\mkern-1.5mu\biggl[#2\biggr]}
\def\PBig#1{\P\mkern-.5mu\Bigl[#1\Bigr]}
\def\Eleft#1{\E\mkern-2mu\left[#1\right]}
\def\Esubleft#1#2{\E_{#1}\mkern-2mu\left[#2\right]}
\def\Emedbig#1{\E\medbigl[#1\medbigr]}
\def\Esubmedbig_#1#2{\E_{#1}\medbigl[#2\medbigr]}
\def\Emeddbig#1{\E\meddbigl[#1\meddbigr]}
\def\Esubmeddbig_#1#2{\E_{#1}\meddbigl[#2\meddbigr]}
\def\Ebig#1{\E\mkern-1.5mu\bigl[#1\bigr]}
\def\Esubbig_#1#2{\E_{#1}\mkern-1.5mu\bigl[#2\bigr]}
\def\EsubBig_#1#2{\E_{#1}\mkern-1.5mu\Bigl[#2\Bigr]}
\def\Esupbig^#1#2{\E^{#1}\mkern-1.5mu\bigl[#2\bigr]}
\def\EsupBig^#1#2{\E^{#1}\mkern-1.5mu\Bigl[#2\Bigr]}
\def\Ebigg#1{\E\mkern-1.5mu\biggl[#1\biggr]}
\def\Esubbigg_#1#2{\E_{#1}\mkern-1.5mu\biggl[#2\biggr]}
\def\EBig#1{\E\mkern-1.5mu\Bigl[#1\Bigr]}

%%%%

\def\Seq#1{\langle #1 \rangle}    %% For sequences.
\def\Seqmedbig#1{\medbigl\langle #1 \medbigr\rangle}    %% For sequences.
\def\Seqmeddbig#1{\meddbigl\langle #1 \meddbigr\rangle}    %% For sequences.
\def\Seqbig#1{\bigl\langle #1 \bigr\rangle}    %% For sequences.
\def\SeqBig#1{\Bigl\langle #1 \Bigr\rangle}    %% For sequences.
\def\flr#1{\lfloor #1 \rfloor}   %% for integer part (floor).
\def\ceil#1{\lceil #1 \rceil}   %% for ceiling.
\def\restrict{\mathord{\upharpoonright}}   %% for restriction

\def\hboxit#1{\leavevmode\hbox{\vrule\vtop{\vbox{\hrule\kern1pt
      \hbox{\vphantom{\tt/}\thinspace\raise1pt\hbox{#1}\thinspace}}
      \hrule}\vrule}} % modified from \cstok
\def\vboxit#1{\leavevmode\hbox{\vrule\vtop{\vbox{\hrule\kern1pt
      \hbox{\vphantom{\tt/}\thinspace\raise1pt\vbox{#1}\thinspace}}
      \hrule}\vrule}} % modified from \cstok
\def\thickboxit#1{\centerline
 {\vbox{\hrule height5pt\kern-3pt\hbox{\vrule width5pt\kern-3pt
 \vbox{\kern-3pt \vbox{#1}}\kern-3pt\vrule width5pt}\kern-3pt\hrule height5pt}}}
\def\colorhrule{\Melon{\hrule height5pt}}
\def\colorvrule{\Melon{\vrule width5pt}}
\def\colorthickboxit#1{\centerline
 {\vbox{\colorhrule \kern-3pt\hbox{\colorvrule \kern-3pt
 \vbox{\kern-3pt \vbox{#1}}\kern-3pt\colorvrule}\kern-3pt\colorhrule}}}

\def\switchemptyset{\let\@ldemptyset=\emptyset \let\@ldvarnothing=\varnothing
                    \let\emptyset=\@ldvarnothing \let\varnothing=\@ldemptyset}
\switchemptyset  %% This is the usual preference.
\def\switchphi{\let\@ldphi=\phi \let\@ldvarphi=\varphi
               \let\phi=\@ldvarphi \let\varphi=\@ldphi}

\def\signum{\mathop{\rm sgn}}
\def\compl{^{\rm c}}  % complement

% The following centers : in mathmode by making : active in mathmode.
\mathchardef\ordinarycolon\mathcode`\:
\mathcode`\:=\string"8000
\begingroup \catcode`\:=\active
  \gdef:{\mathrel{\mathop\ordinarycolon}}
\endgroup

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Some math tweaks.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% for displayed fractions in text, the normal size is too small and the
% display size is too large; use as \textfrac#1#2 for {#1 \over #2}

\def\bottomstrut{\vrule height2.5pt depth2.5pt width0pt}%
\def\topstrut{\vrule height7.5pt depth0.5pt width0pt}%
\def\textfrac#1#2{\hbox{\smallersize {$\textstyle \bottomstrut #1 \over
      \topstrut \textstyle #2 $}}}

% to have slanted fractions in text, use this from the TeXBook:

\def\slantfrac#1#2{\leavevmode\kern.1em
  \raise.5ex\hbox{\the\scriptfont0 #1}\kern-.1em
  /\kern-.15em\lower.25ex\hbox{\the\scriptfont0 #2}}

% in math, use this:

\def\slantmathfrac#1#2{\kern.1em
  \raise.5ex\hbox{$\scriptstyle #1$}\kern-.1em
  /\kern-.1em\lower.5ex\hbox{$\scriptstyle #2$}}

% Sometimes the sqrt is too large; the following is adjustable.
% Use as \sqrt{\updown{8}{3}{stuff}}

\def\updown#1#2#3{\vrule width0pt height #1 pt depth #2 pt \smash{#3}}

% \overline that takes into account the slant:
% (The accents package for LaTeX does this and somewhat more, it seems.)
% From the TeXbook, p. 375:
{\catcode`p=12 \catcode`t=12 \gdef\\#1pt{#1}}
\let\getfactor=\\
\def\kslant#1{\kern\expandafter\getfactor\the\fontdimen1#1\ht0}
\def\kmslant#1{\kern-\expandafter\getfactor\the\fontdimen1#1\ht0}
\def\semikslant#1{\ht0=.5\ht0 \kern\expandafter\getfactor\the\fontdimen1#1\ht0 \ht0=2\ht0}
\def\semikmslant#1{\ht0=.5\ht0 \kern-\expandafter\getfactor\the\fontdimen1#1\ht0 \ht0=2\ht0}
%
% Inspired by the TeXbook, p. 359 on \skew:
\def\overlinesl#1{\mathchoice
   {\setbox0=\hbox{$\displaystyle #1$}\kslant{\textfont1}%
   \displaystyle\overline{\kmslant{\textfont1}\box0}}
   {\setbox0=\hbox{$\textstyle #1$}\kslant{\textfont1}%
   \textstyle\overline{\kmslant{\textfont1}\box0}}
   {\setbox0=\hbox{$\scriptstyle #1$}\kslant{\textfont1}%
   \scriptstyle\overline{\kmslant{\textfont1}\box0\kern-\scriptspace}}
   {\setbox0=\hbox{$\scriptscriptstyle #1$}\kslant{\textfont1}%
   \scriptscriptstyle\overline{\kmslant{\textfont1}\box0\kern-\scriptspace}}}
         % I don't know why using \kslant{\scriptfont1} does not work.
% The following corrects it by only half the amount.
\def\overlinesemisl#1{\mathchoice
   {\setbox0=\hbox{$\displaystyle #1$}\semikslant{\textfont1}%
   \displaystyle\overline{\semikmslant{\textfont1}\box0}}
   {\setbox0=\hbox{$\textstyle #1$}\semikslant{\textfont1}%
   \textstyle\overline{\semikmslant{\textfont1}\box0}}
   {\setbox0=\hbox{$\scriptstyle #1$}\semikslant{\textfont1}%
   \scriptstyle\overline{\semikmslant{\textfont1}\box0\kern-\scriptspace}}
   {\setbox0=\hbox{$\scriptscriptstyle #1$}\semikslant{\textfont1}%
   \scriptscriptstyle\overline{\semikmslant{\textfont1}\box0\kern-\scriptspace}}}
% Same for underline:
\def\underlinesl#1{\mathchoice
   {\setbox0=\hbox{$\displaystyle #1$}%
   \displaystyle\underline{\copy0\kmslant{\textfont1}}\kslant{\textfont1}}
   {\setbox0=\hbox{$\textstyle #1$}%
   \textstyle\underline{\copy0\kmslant{\textfont1}}\kslant{\textfont1}}
   {\setbox0=\hbox{$\scriptstyle #1$}%
   \scriptstyle\underline
      {\copy0\kmslant{\textfont1}\kern-\scriptspace}\kslant{\textfont1}}
   {\setbox0=\hbox{$\scriptscriptstyle #1$}%
   \scriptscriptstyle\underline
      {\copy0\kmslant{\textfont1}\kern-\scriptspace}\kslant{\textfont1}}}


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Fill out a line that is too small or too big via scaling in pdf:
% Use as \pdfjustifyline{the material of the line}.
% For a display, \pdfjustifyline{$\displaystyle the material of the line$}.
% This works only with dvipdfmx.

\newcount\scalecount
\def\scale#1#2#3{{\setbox0
   =\hbox{\special{pdf: bt xscale #1 yscale #2 }#3\special{pdf:
   et}}\wd0=#1\wd0 \ht0=#2\ht0 \dp0=#2\dp0 \box0 }}
\def\pdfjustifyline#1{\setbox0=\hbox{#1}\quotient{\hsize}{\wd0}%
   \line{\specialscale{\box0}}}
% It seems to work only if I put in a \number in the \special or two
% \number's with explicit decimal points.
\def\specialscale#1{\special{pdf: bt xscale \number\scalecount 
   }\special{pdf: bt xscale .001 }#1\special{pdf: et }\special{pdf: et }}
\def\quotient#1#2{\dimen1=#1 \dimen2=#2 \count1=\dimen1 \count2=\dimen2
    \scalecount=\count1 
    \divide\count2 by 1000
    \divide\scalecount by \count2 }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%  Restore the catcode value for @ that was previously saved.
\catcode`\@=\csname saveatsymbolcode\endcsname
