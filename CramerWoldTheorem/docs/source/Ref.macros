%% Macros that used to be used, kept for historical reasons only.

\def\inviscite#1{\citeinc{#1}}  %% to have the ref put in
   %% the refs.
   %% This is here only for compatibility.


%
% older bib macros:
% 
\def\beginreferences{\vskip0pt plus.3\vsize \penalty -150 \vskip0pt
 plus-.3\vsize \bigskip\bigskip \vskip \parskip
 \begingroup\baselineskip=12pt\frenchspacing
       \multiply\normalbaselineskip by \baselineskipmultiplier  % OK?
   \bibliographytitle
   \vskip12pt\parindent=0pt
   \def\and{{\rm and }}
   \def\rrf##1 (##2){{\sc ##1}\ (##2).}
   \everypar={\hangindent=.8cm\hangafter=1\rrf }}
\def\endreferences{\bigskip\bigskip\endgroup}
